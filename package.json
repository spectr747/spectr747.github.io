{
  "name": "symbios-site",
  "private": true,
  "description": "Лендинг Symbios. Сайт статический и публикуется без сборки; эти инструменты нужны только для проверок.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npx --yes http-server -p 8000 -c-1 .",
    "lint": "npm run lint:html && npm run lint:css && npm run lint:format",
    "lint:html": "html-validate index.html",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:format": "prettier --check \"**/*.{js,css,json,md}\"",
    "format": "prettier --write \"**/*.{js,css,json,md}\" && stylelint --fix \"css/**/*.css\""
  },
  "devDependencies": {
    "html-validate": "^11.18.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
